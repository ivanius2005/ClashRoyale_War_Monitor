# Copia este archivo como .env y rellénalo.

# Clave de https://developer.clashroyale.com creada con la IP 45.79.218.79 (proxy de RoyaleAPI)
CR_API_KEY=pega_aqui_tu_token

# Puerto y dirección donde escucha el servidor.
# 127.0.0.1 = solo accesible desde la propia máquina (ideal detrás de Cloudflare Tunnel)
PORT=3055
HOST=127.0.0.1

# Fija un único clan. La web ya no pedirá el tag y el servidor rechazará los demás.
# Hace falta para el informe diario y para la tarjeta del dashboard.
CLAN_TAG=#LVR980LQ

# Registro diario de mazos: el servidor guarda cada pocos minutos los mazos de cada jugador
# para saber cuántos jugó cada día (la API solo da el total semanal). Hace falta para que la
# nota de expulsión sea exacta. Pon tu clan (o varios, separados por comas).
# Si pones CLAN_TAG y dejas esto vacío, se registra ese clan.
# TRACK_CLANS=#TUTAG
# TRACK_MINUTES=10
# DATA_DIR=data

# Semanas de historial para la simulación y las expulsiones (máx. 20)
HISTORY_WEEKS=10

# Caché en segundos: datos en directo y datos de historial
CACHE_SECONDS=30
HISTORY_CACHE_SECONDS=600

# Consultas a /api por minuto y por IP (0 = sin límite)
RATE_LIMIT_PER_MIN=60

# Usa la IP real que manda Cloudflare. Por defecto solo si HOST es 127.0.0.1.
# Ponlo a 1 si usas Docker con cloudflared delante.
# TRUST_PROXY=1

# Si la web se sirve desde otro dominio (p. ej. Cloudflare Pages), permítelo aquí.
# Separados por comas.
# CORS_ORIGINS=https://ivanius2005.es,https://www.ivanius2005.es

# Solo si algún día no usas el proxy de RoyaleAPI
# CR_API_BASE=https://proxy.royaleapi.dev/v1

# ---------- Acceso restringido (Cloudflare Access) ----------
# Con 1, el servidor solo atiende a quien llega a través de Cloudflare Access
# (cabecera Cf-Access-Authenticated-User-Email). Ponlo en cuanto tengas Access configurado.
REQUIRE_ACCESS=0

# Ruta alternativa a /api para la tarjeta del dashboard (dashboard.tudominio.es/guerra-api/summary)
# API_ALIAS=/guerra-api

# Dirección pública de la web: se enlaza desde el aviso de Discord
PUBLIC_URL=https://crwar.ivanius2005.es

# ---------- Informe diario ----------
# Por defecto: a las 08:00 (hora de Madrid) de viernes a lunes, es decir, durante los 4 días de batalla.
# REPORT_ENABLED=1
# REPORT_HOUR=8
# REPORT_MINUTE=0
# REPORT_DAYS=fri,sat,sun,mon
# REPORT_TZ=Europe/Madrid

# Webhook de Discord para el aviso (Ajustes del canal → Integraciones → Webhooks).
# Puede ser el de siempre o el de un canal solo para la guerra. Vacío = no se avisa.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---------- PDF ----------
# El PDF lo genera scripts/pdf_report.py. Necesita: sudo apt install python3-reportlab
# Para que salgan todos los símbolos de los nombres: sudo apt install fonts-dejavu fonts-freefont-ttf fonts-ipafont-gothic fonts-wqy-zenhei
# PDF_ENABLED=1
# PDF_PYTHON=python3

# Simulaciones del resumen en directo y cada cuánto se recalcula (segundos)
# SUMMARY_RUNS=10000
# SUMMARY_CACHE_SECONDS=60

# ---------- Web pública: cualquier clan ----------
# Con ANY_CLAN=1 cualquiera puede ver cualquier clan (portada con buscador y /c/TAG).
# CLAN_TAG sigue siendo el clan de casa: registro diario, informe de las 08:00 y PDF (los demás clanes ven el PDF «bloqueado»).
ANY_CLAN=1
# Clanes nuevos (no consultados antes) que se admiten por minuto entre todos los visitantes; el de casa no cuenta
NEW_CLANS_PER_MIN=10
# Simulaciones del resumen de la portada para los demás clanes (el de casa usa SUMMARY_RUNS)
SUMMARY_RUNS_OTHERS=5000
# Uso de la API, caché y clanes rechazados: curl http://127.0.0.1:3055/api/stats (solo desde la propia máquina)
